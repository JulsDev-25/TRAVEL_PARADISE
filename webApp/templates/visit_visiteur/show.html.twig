di{% extends 'base.html.twig' %}

{% block title %}Détail de la présence{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails de la présence</h1>

    <table class="table">
        <tr><th>Id</th><td>{{ visit_visiteur.id }}</td></tr>
        <tr><th>Visiteur</th><td>{{ visit_visiteur.visiteur.nom }} {{ visit_visiteur.visiteur.prenom }}</td></tr>
        <tr><th>Visite</th><td>{{ visit_visiteur.visite.lieu }} ({{ visit_visiteur.visite.date|date('Y-m-d') }})</td></tr>
        <tr><th>Présent</th><td>{{ visit_visiteur.present ? 'Oui' : 'Non' }}</td></tr>
        <tr><th>Commentaire</th><td>{{ visit_visiteur.commentaire }}</td></tr>
    </table>

    <div class="d-flex gap-2>
        <a href="{{ path('app_visit_visiteur_edit', {'id': visit_visiteur.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('visit_visiteur/_delete_form.html.twig') }}
    </div>

    <a href="{{ path('app_visit_visiteur_index') }}" class="mt-3">Retour à la liste</a>

{% endblock %}
