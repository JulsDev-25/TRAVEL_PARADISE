<form method="post" action="{{ path('app_visite_delete', {'id': visite.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette visite ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ visite.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
