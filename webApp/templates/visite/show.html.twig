{% extends 'base.html.twig' %}

{% block title %}Visite
{% endblock %}

{% block body %}
	<h1>Visite</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ visite.id }}</td>
			</tr>
			<tr>
				<th>Photo</th>
				<td><img src="{{ visite.photo }}" height="50" alt="Image_de_la_visite"></td>
			</tr>
			<tr>
				<th>Pays</th>
				<td>{{ visite.pays }}</td>
			</tr>
			<tr>
				<th>Lieu</th>
				<td>{{ visite.lieu }}</td>
			</tr>
			<tr>
				<th>Date</th>
				<td>{{ visite.date ? visite.date|date('Y-m-d') : '' }}</td>
			</tr>
			<tr>
				<th>HeureDebut</th>
				<td>{{ visite.heureDebut ? visite.heureDebut|date('H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Duree</th>
				<td>{{ visite.duree }}</td>
			</tr>
			<tr>
				<th>HeureFin</th>
				<td>{{ visite.heureFin ? visite.heureFin|date('H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Commentaire</th>
				<td>{{ visite.commentaire }}</td>
			</tr>
		</tbody>
	</table>

	<h2>Guide touristique: {{visite.guide.id}} - {{visite.guide.nom}} {{visite.guide.prenom}}</h2>

	<h2>Visteurs</h2>
	{% for v in visite.visiteursSelectionnes %}
		<p style="color: green">
			-
			{{ v.nom }}
			{{ v.prenom }}</p>
	{% endfor %}

	<div class="col d-flex gap-2">
		<a href="{{ path('app_visite_edit', {'id': visite.id}) }}" class="btn btn-warning">edit</a>
		{{ include('visite/_delete_form.html.twig') }}"
	</div>
	<div class="mt-3">
		<a href="{{ path('app_visite_index') }}">back to list</a>
	</div>
{% endblock %}
