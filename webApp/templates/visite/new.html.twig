{% extends 'base.html.twig' %}

{% block title %}Créer une nouvelle visite
{% endblock %}

{% block body %}
    {# alert de notification #}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			{{ message }}
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
		</div>
	{% endfor %}

	<div class="container">
		<h1 class="mb-4">Créer une nouvelle visite</h1>

		{{ include('visite/_form.html.twig', {'button_label': 'Créer la visite'}) }}

        <hr class="my-4">
		<button class="btn btn-outline-primary mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#formVisiteurCollapse" aria-expanded="false" aria-controls="formVisiteurCollapse">
			➕ Ajouter un visiteur à la volée
		</button>

		<!-- Formulaire repliable -->
		<div class="collapse" id="formVisiteurCollapse">
			<div class="card card-body border-primary">
				{{ form_start(formVisiteur) }}
				<div class="row">
					<div class="col-md-6">
						{{ form_row(formVisiteur.nom) }}
					</div>
					<div class="col-md-6">
						{{ form_row(formVisiteur.prenom) }}
					</div>
				</div>
				<div class="col-12">
					<button class="btn btn-success mt-2">Ajouter un visiteur</button>
				</div>
				{{ form_end(formVisiteur) }}
			</div>
		</div>

		<div class="mt-4">
			<a href="{{ path('app_visite_index') }}" class="mt-3">Retour à la liste</a>
		</div>
	</div>
{% endblock %}
