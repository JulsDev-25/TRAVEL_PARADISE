{% extends 'base.html.twig' %}

{% block title %}Détails du guide{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails du guide</h1>

    <table class="table table-bordered">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ guide.id }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td><img src="{{ guide.photo }}" height="80" alt="Photo guide"></td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ guide.nom }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ guide.prenom }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>
                    <span class="badge bg-{{ guide.statut ? 'success' : 'secondary' }}">
                        {{ guide.statut ? 'Actif' : 'Inactif' }}
                    </span>
                </td>
            </tr>
            <tr>
                <th>Pays</th>
                <td>{{ guide.pays }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3">
        <a href="{{ path('app_guide_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_guide_edit', {'id': guide.id}) }}" class="btn btn-warning">Modifier</a>
        {{ include('guide/_delete_form.html.twig') }}
    </div>
{% endblock %}
