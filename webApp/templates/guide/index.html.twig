{% extends 'base.html.twig' %}

{% block title %}Liste des guides{% endblock %}

{% block body %}

    <a href="{{ path('app_guide_new') }}" class="btn btn-success mb-3">Ajouter un guide</a>

    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Photo</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Actif</th>
                <th>Pays</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for guide in guides %}
            <tr>
                <td>{{ guide.id }}</td>
                <td><img src="{{ guide.photo }}" width="80" alt="Photo guide"></td>
                <td>{{ guide.nom }}</td>
                <td>{{ guide.prenom }}</td>
                <td>
                    <span class="badge bg-{{ guide.statut ? 'success' : 'secondary' }}">
                        {{ guide.statut ? 'Oui' : 'Non' }}
                    </span>
                </td>
                <td>{{ guide.pays }}</td>
                <td>
                    <a href="{{ path('app_guide_show', {'id': guide.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                    <a href="{{ path('app_guide_edit', {'id': guide.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center">Aucun guide trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
