{% extends 'base.html.twig' %}

{% block title %}Modifier le guide{% endblock %}

{% block body %}
    <h1 class="mb-4">Modifier le guide</h1>

    {% if guide.photo %}
        <img src="{{ guide.photo }}" height="80" class="mb-3" alt="Photo actuelle du guide">
    {% endif %}

    {{ include('guide/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

    <div class="mt-4">
        <a href="{{ path('app_guide_index') }}" class="btn btn-secondary">Retour à la liste</a>
        {{ include('guide/_delete_form.html.twig') }}
    </div>
{% endblock %}
