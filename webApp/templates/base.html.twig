                integrity="sha384-q2QKYBqqJzzy9Hbo3BHpDwN8CH7q6j9P5z45dZ+4rBOVr6ZK4q1F+JfTf5v6Yo6K" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body class="container py-4">
        {% block body %}{% endblock %}
    </body>
</html>
