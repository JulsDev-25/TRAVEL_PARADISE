{% extends 'base.html.twig' %}

{# Définir le titre de la topbar #}
{% block topbar_title %}Dashboard
{% endblock %}

{% block body %}
	{# Assurez-vous que le bloc s'appelle 'body' et non 'content' #}

	<div class="dashboard-welcome">
		<h1>Bienvenue sur votre tableau de bord</h1>
		<p>Voici vos statistiques et activités récentes.</p>
	</div>

	<div
		class="dashboard-grid">

		{# Carte: Guides total #}
		<div class="stat-card">
			<div class="card-icon">
				<i class="fas fa-users"></i>
			</div>
			<div class="card-content">
				<div class="card-title">Guides total</div>
				<div class="card-value">{{ totalGuides }}</div>
				<div class="card-subtitle">Il y a un mois</div>
			</div>
		</div>

		{# Carte: Visites total #}
		<div class="stat-card">
			<div class="card-icon">
				<i class="fas fa-map-marked-alt"></i>
			</div>
			<div class="card-content">
				<div class="card-title">Visites total</div>
				<div class="card-value">{{ totalVisites }}</div>
				<div class="card-subtitle">Il y a une semaine</div>
			</div>
		</div>

		{# Carte: Taux de présence #}
		<div class="stat-card">
			<div class="card-icon">
				<i class="fas fa-chart-line"></i>
			</div>
			<div class="card-content">
				<div class="card-title">Taux de présence</div>
				<div class="card-value">{{ tauxPresence }}%</div>
				<div class="card-subtitle">Présences générale</div>
			</div>
		</div>
	</div>
	{# Carte: Taux de présences (similaire au précédent) #}
	<div class="graph-card">
		<div class="graph-header">
			<h2 class="graph-title">Visites par guide</h2>
			<div class="graph-controls">
				<span>Mai 2025</span>
				<button class="nav-btn">
					<i class="fas fa-chevron-left"></i>
				</button>
				<button class="nav-btn">
					<i class="fas fa-chevron-right"></i>
				</button>
			</div>
		</div>
		<div class="graph-body">
			<canvas id="visitesParGuideChart" width="400" height="200"></canvas>
		</div>
	</div>

</div>

{# Si vous avez des scripts spécifiques pour les graphiques, ajoutez-les ici #}
{% block javascripts %}
	{{ parent() }}
	{# Pour inclure les scripts de base.html.twig #}

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
let graphData = {{ graphData|json_encode|raw }};
const labels = graphData.map(g => g.guide);
const data = graphData.map(g => g.nb);

const canvas = document.getElementById('visitesParGuideChart');
if (canvas) {
const ctx = canvas.getContext('2d');
new Chart(ctx, {
type: 'bar',
data: {
labels: labels,
datasets: [
{
label: 'Nombre de visites',
data: data,
backgroundColor: '#4e73df',
borderRadius: 5
}
]
},
options: {
responsive: true,
plugins: {
legend: {
display: false
},
title: {
display: true,
text: 'Visites par guide'
}
},
scales: {
y: {
beginAtZero: true
}
}
}
});
}
});
	</script>
{% endblock %}{% endblock %}
