{% extends 'base.html.twig' %}

{% block title %}Détail du visiteur{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails du visiteur</h1>

    <table class="table">
        <tr><th>Id</th><td>{{ visiteur.id }}</td></tr>
        <tr><th>Nom</th><td>{{ visiteur.nom }}</td></tr>
        <tr><th>Prénom</th><td>{{ visiteur.prenom }}</td></tr>
    </table>
    
    <div class="dflex gap-2">
        <a href="{{ path('app_visiteur_edit', {'id': visiteur.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('visiteur/_delete_form.html.twig') }}
    </div>
    
    <a href="{{ path('app_visiteur_index') }}" class="mt-3">Retour à la liste</a>

    
{% endblock %}
