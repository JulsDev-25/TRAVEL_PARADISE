{% extends 'base.html.twig' %}

{% block title %}Liste des visiteurs{% endblock %}

{% block body %}
    <h1 class="mb-2">Liste des visiteurs</h1>

    <a href="{{ path('app_visiteur_new') }}" class="btn btn-success my-3">Créer un nouveau visiteur</a>
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for visiteur in visiteurs %}
            <tr>
                <td>{{ visiteur.id }}</td>
                <td>{{ visiteur.nom }}</td>
                <td>{{ visiteur.prenom }}</td>
                <td>
                    <a href="{{ path('app_visiteur_show', {'id': visiteur.id}) }}" class="btn btn-sm btn-primary">Afficher</a>
                    <a href="{{ path('app_visiteur_edit', {'id': visiteur.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-center">Aucun visiteur trouvé.</td></tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
